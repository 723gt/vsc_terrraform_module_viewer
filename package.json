{
  "name": "terraform-module-viewer",
  "displayName": "Terraform Module Viewer",
  "description": "Terraform モジュール（ディレクトリ内の .tf ファイル群）の variables / outputs / resources などを一覧表示するビューア",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/723gt/vsc_terrraform_module_viewer.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "terraformModuleViewer.open",
        "title": "Terraform: モジュールビューアを開く",
        "icon": "$(preview)"
      },
      {
        "command": "terraformModuleViewer.openFile",
        "title": "Terraform: このファイルだけをビューアで開く",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "terraformModuleViewer.open",
          "when": "resourceExtname == .tf",
          "group": "navigation"
        },
        {
          "command": "terraformModuleViewer.openFile",
          "when": "resourceExtname == .tf",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "terraformModuleViewer.openFile",
          "when": "resourceExtname == .tf",
          "group": "terraform@1"
        }
      ],
      "editor/context": [
        {
          "command": "terraformModuleViewer.openFile",
          "when": "resourceExtname == .tf",
          "group": "terraform@1"
        }
      ],
      "explorer/context": [
        {
          "command": "terraformModuleViewer.open",
          "when": "explorerResourceIsFolder || resourceExtname == .tf",
          "group": "navigation@99"
        },
        {
          "command": "terraformModuleViewer.openFile",
          "when": "resourceExtname == .tf",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Terraform Module Viewer",
      "properties": {
        "terraformModuleViewer.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": ".tf ファイルの保存時にビューアを自動更新する"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "scripts": {
    "test": "node test/run.js",
    "package": "vsce package --no-dependencies"
  }
}
